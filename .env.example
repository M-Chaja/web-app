# Copy to .env.local for local dev (gitignored). In Vercel, set this as a
# Project Environment Variable instead — see README.md for deployment notes.
#
# The Maps JS API key must have app.m-chaja.com (and, for local dev,
# localhost) allowlisted under its HTTP referrer restrictions in Google
# Cloud Console, or the map silently falls back to a static placeholder.
VITE_GOOGLE_MAPS_API_KEY=
